{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"customDuotone": true,
			"customGradient": true,
			"textColor": true,
			"background": true,
			"palette": [
				{
					"slug": "base",
					"color": "#f2f3f6",
					"name": "Base"
				},
				{
					"slug": "surface",
					"color": "#ffffff",
					"name": "Surface"
				},
				{
					"slug": "contrast",
					"color": "#1c1c1e",
					"name": "Contrast"
				},
				{
					"slug": "secondary",
					"color": "#55555c",
					"name": "Secondary text"
				},
				{
					"slug": "tertiary",
					"color": "#6e6e76",
					"name": "Tertiary text"
				},
				{
					"slug": "accent",
					"color": "#0071e3",
					"name": "Accent"
				},
				{
					"slug": "accent-soft",
					"color": "#e3effc",
					"name": "Accent tint"
				},
				{
					"slug": "inverse",
					"color": "#f5f5f7",
					"name": "Inverse"
				}
			],
			"gradients": [
				{
					"slug": "ambient",
					"gradient": "linear-gradient(160deg, rgba(0,113,227,0.08) 0%, rgba(118,75,162,0.06) 45%, rgba(10,132,122,0.05) 100%)",
					"name": "Ambient light"
				},
				{
					"slug": "dusk",
					"gradient": "linear-gradient(160deg, #1c1c22 0%, #232a38 100%)",
					"name": "Dusk"
				},
				{
					"slug": "sheen",
					"gradient": "linear-gradient(135deg, rgba(255,255,255,0.9), rgba(255,255,255,0.4))",
					"name": "Glass sheen"
				}
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji'",
					"slug": "system",
					"name": "System"
				},
				{
					"fontFamily": "ui-monospace, 'SF Mono', SFMono-Regular, 'JetBrains Mono', Menlo, Consolas, monospace",
					"slug": "mono",
					"name": "Monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"size": "0.75rem",
					"name": "Extra small"
				},
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "clamp(1rem, 0.96rem + 0.2vw, 1.0625rem)",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "clamp(1.125rem, 1.06rem + 0.3vw, 1.25rem)",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "clamp(1.3rem, 1.18rem + 0.6vw, 1.625rem)",
					"name": "Extra large"
				},
				{
					"slug": "xx-large",
					"size": "clamp(1.55rem, 1.35rem + 1vw, 2rem)",
					"name": "Huge"
				},
				{
					"slug": "xxx-large",
					"size": "clamp(1.9rem, 1.55rem + 1.8vw, 2.6rem)",
					"name": "Gigantic"
				},
				{
					"slug": "display",
					"size": "clamp(2.3rem, 1.7rem + 3vw, 3.5rem)",
					"name": "Display"
				},
				{
					"slug": "display-xl",
					"size": "clamp(2.75rem, 1.8rem + 4.8vw, 4.75rem)",
					"name": "Display XL"
				}
			],
			"letterSpacing": true
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			],
			"spacingSizes": [
				{
					"slug": "xs",
					"size": "0.5rem",
					"name": "Extra small"
				},
				{
					"slug": "sm",
					"size": "0.75rem",
					"name": "Small"
				},
				{
					"slug": "md",
					"size": "1rem",
					"name": "Medium"
				},
				{
					"slug": "lg",
					"size": "1.5rem",
					"name": "Large"
				},
				{
					"slug": "xl",
					"size": "2.5rem",
					"name": "Extra large"
				},
				{
					"slug": "xxl",
					"size": "4rem",
					"name": "Huge"
				},
				{
					"slug": "section",
					"size": "clamp(3rem, 7vw, 6rem)",
					"name": "Section"
				}
			],
			"padding": true,
			"margin": true,
			"blockGap": true
		},
		"border": {
			"radius": true,
			"width": true,
			"style": true
		},
		"custom": {
			"radius": {
				"sm": "10px",
				"md": "14px",
				"lg": "20px",
				"xl": "28px",
				"pill": "999px"
			},
			"glass": {
				"blur": "20px",
				"saturate": "180%"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--custom--page-background, var(--page-background, #f2f3f6))",
			"text": "var(--text-primary)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.75",
			"letterSpacing": "-0.01em"
		},
		"spacing": {
			"padding": {
				"left": "0px",
				"right": "0px"
			}
		},
		"elements": {
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--system)",
					"fontSize": "var(--wp--preset--font-size--display)",
					"fontWeight": "700",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.1"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--system)",
					"fontSize": "var(--wp--preset--font-size--xxx-large)",
					"fontWeight": "700",
					"letterSpacing": "-0.015em",
					"lineHeight": "1.15"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--system)",
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "650",
					"letterSpacing": "-0.015em",
					"lineHeight": "1.2"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--system)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "650",
					"lineHeight": "1.25"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--system)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "650"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--system)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "650",
					"letterSpacing": "0.02em",
					"textTransform": "uppercase"
				}
			},
			"link": {
				"color": {
					"text": "var(--accent)"
				},
				":hover": {
					"color": {
						"text": "var(--accent-hover)"
					}
				},
				"typography": {
					"textDecoration": "none"
				}
			},
			"button": {
				"color": {
					"background": "var(--accent)",
					"text": "var(--accent-text)"
				},
				"border": {
					"radius": "var(--glass-radius-pill)",
					"width": "0"
				},
				"spacing": {
					"padding": {
						"top": "0.65em",
						"bottom": "0.65em",
						"left": "1.4em",
						"right": "1.4em"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"background": "var(--accent-hover)",
						"text": "var(--accent-text)"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--text-tertiary)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)"
				}
			}
		},
		"blocks": {
			"core/paragraph": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "underline"
						}
					}
				}
			},
			"core/post-title": {
				"typography": {
					"fontWeight": "700",
					"letterSpacing": "-0.015em"
				}
			},
			"core/post-date": {
				"color": {
					"text": "var(--text-tertiary)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/post-author-name": {
				"color": {
					"text": "var(--text-secondary)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/post-terms": {
				"color": {
					"text": "var(--text-tertiary)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)"
				}
			},
			"core/post-excerpt": {
				"color": {
					"text": "var(--text-secondary)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/quote": {
				"border": {
					"color": "var(--accent)",
					"width": "0px 0px 0px 4px",
					"style": "solid"
				},
				"spacing": {
					"padding": {
						"left": "1.5rem",
						"top": "0.5rem",
						"bottom": "0.5rem"
					}
				}
			},
			"core/pullquote": {
				"border": {
					"color": "var(--glass-border-strong)",
					"width": "1px",
					"top": "1px",
					"bottom": "1px"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.25",
					"letterSpacing": "-0.015em"
				}
			},
			"core/separator": {
				"border": {
					"color": "var(--glass-border-strong)",
					"width": "1px"
				}
			},
			"core/buttons": {
				"spacing": {
					"blockGap": "0.75rem"
				}
			},
			"core/button": {
				"border": {
					"radius": "var(--glass-radius-pill)"
				},
				"shadow": "none",
				"variations": {
					"outline": {
						"border": {
							"color": "currentColor",
							"width": "1.5px",
							"source": "inset"
						},
						"color": {
							"background": "transparent",
							"text": "var(--accent)"
						},
						"spacing": {
							"padding": {
								"top": "calc(0.65em - 1.5px)",
								"bottom": "calc(0.65em - 1.5px)",
								"left": "calc(1.4em - 1.5px)",
								"right": "calc(1.4em - 1.5px)"
							}
						}
					},
					"fill": {
						"color": {
							"background": "var(--accent)",
							"text": "var(--accent-text)"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "550"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--text-primary)"
						},
						":hover": {
							"color": {
								"text": "var(--accent)"
							}
						}
					}
				}
			},
			"core/search": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/site-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "700",
					"letterSpacing": "-0.015em"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--text-primary)"
						}
					}
				}
			},
			"core/cover": {
				"border": {
					"radius": "var(--glass-radius-xl)"
				}
			},
			"core/group": {
				"border": {
					"radius": "var(--glass-radius-lg)"
				}
			},
			"core/columns": {
				"spacing": {
					"blockGap": "clamp(1rem, 3vw, 2.5rem)"
				}
			},
			"core/query-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxx-large)"
				}
			}
		}
	}
}
